{
  "schemaVersion": 1,
  "id": "anti-offhand_place",
  "version": "${version}",
  "name": "anti offhand place",
  "description": "allows you to prevent yourself from placing a block in your offhand\nfor example if you have an item like a torch in your offhand(for dynamic lights or sm) it prevents you from placing it",
  "authors": [
    "pat600130"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/anti-offhand_place/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.pat600.fabric.antiOffhandPlaceFabric"
    ],
    "client": [
      "net.pat600.fabric.client.antiOffhandPlaceFabricClient"
    ]
  },
  "mixins": [
    "anti-offhand_place.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
